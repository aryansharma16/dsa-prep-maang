# Copy to .env and fill in. .env is gitignored; this file is not, so keep real
# secrets out of it.

NODE_ENV=development
PORT=4000

MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dsa-prep
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

LEETCODE_API=https://leetcode-api-pied.vercel.app

# --- File uploads (Cloudinary) -------------------------------------------
# Optional. Without these the server still runs and everything except uploading
# a profile picture works; that one endpoint answers 503 UPLOADS_DISABLED.
#
# Copy the line straight off Cloudinary's API Keys screen — it is already in
# this shape:
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Or set the three parts separately, if a URL-shaped secret is awkward to store
# on your host. CLOUDINARY_URL wins when both are present.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
#
# Prefix every asset this app creates lives under, so a shared cloud stays tidy.
CLOUDINARY_FOLDER=maang-prep

# --- AI (Google Gemini) --------------------------------------------------
# Optional. Without this the server still runs and everything except the AI
# features works; those endpoints answer 503 AI_DISABLED, and the motivation
# lines fall back to the seeded ones, which is the normal path anyway.
#
# Get a key from https://aistudio.google.com/apikey. It is a Generative
# Language API key — a Google Cloud key restricted to other APIs will be
# accepted by this file and then rejected by Google as API_KEY_INVALID.
GEMINI_API_KEY=
#
# Google retires these on a published schedule, so they are variables rather
# than constants in the code. Two of them, because the two things this app asks
# a model for have opposite shapes.
#
# The quality tier. Admin drafting only — a handful of calls when someone clicks
# a button, every line read by a human before it ships. Free-tier quota on the
# newest Flash is 20 requests per day per model, which is plenty for that and
# nowhere near enough for anything per-learner.
GEMINI_MODEL=gemini-3.6-flash
#
# The cheap tier. This is what runs once per learner per day for the motivation
# line, so it scales with signups and needs quota headroom more than polish.
# Falls back to GEMINI_MODEL when unset.
#
# gemini-3.5-flash-lite is cheaper again, but it was measured against this app's
# own prompt and got the arithmetic wrong about one time in four, which no
# amount of output validation can catch. Set it only if you want that trade.
GEMINI_MODEL_FAST=gemini-3.5-flash

# --- AI (chat assistant providers) ---------------------------------------
# The chat assistant tries these in the order the admin panel lists them,
# falling through to the next one on failure. All optional: a key that is
# absent simply means that provider is never a candidate. With none of them
# set, chat runs on Gemini alone.
#
# Run `npm run ai:probe` after setting any of these. It streams one prompt
# through every configured provider and prints time-to-first-token, which is
# the only way to find out that a key authenticates but cannot bill — all
# three of these list their models happily on an account with no credit and
# then answer 402 the moment you ask for a token.
#
# Cerebras — https://cloud.cerebras.ai. Fastest to first token by a wide
# margin, which is the speed a reader actually perceives. Requires billing to
# be enabled; without it every model answers 402 "Payment required".
CEREBRAS_API_KEY=
#
# DeepSeek — https://platform.deepseek.com. Strong on code and the cheapest of
# the three to top up. Answers 402 "Insufficient Balance" at zero balance.
DEEPSEEK_API_KEY=
#
# xAI Grok — https://console.x.ai. Answers 403 "your team doesn't have any
# credits or licenses yet" until the team is funded.
GROK_API_KEY=
#
# Override a base URL only if a vendor moves one. Defaults are
# api.cerebras.ai/v1, api.deepseek.com/v1 and api.x.ai/v1.
# CEREBRAS_BASE_URL=
# DEEPSEEK_BASE_URL=
# GROK_BASE_URL=

# --- Admin panel ---------------------------------------------------------
# The one account that owns the site. Pinned here rather than stored as an
# editable row: no API path can grant or revoke super_admin, so the role cannot
# be handed out by a bug in the role endpoint or by a stolen admin session.
#
# The account is promoted on boot, on register and at every login, so it does
# not need to exist yet when you set this. Leave it unset and the app simply has
# no super admin — the panel still works for admin and dev_member, but nobody
# can edit problems or patterns, assign roles, or delete an account.
SUPER_ADMIN_EMAIL=you@example.com
