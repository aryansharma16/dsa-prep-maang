# Copy to .env and fill in. .env is gitignored; this file is not, so keep real
# secrets out of it.

NODE_ENV=development
PORT=4000

MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dsa-prep
CLIENT_URL=http://localhost:5173
# The public address links in emails point at — reset links, "sign in",
# "review request". CLIENT_URL above is a list of origins CORS accepts, and its
# first entry is usually localhost; without this, production would email real
# users links to localhost. Leave unset in development.
# APP_URL=https://dsa-prep-maang.vercel.app

JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

LEETCODE_API=https://leetcode-api-pied.vercel.app

# --- Rate limiting -------------------------------------------------------
# On by default, in development too, so the limits are exercised by ordinary use
# rather than discovered in production. The per-route ceilings — sign-in
# attempts, registrations, chat, uploads, writes — live in
# src/middleware/rateLimit.js next to the reasoning that picked them. Only the
# two below are worth changing without a redeploy.
#
# The backstop across every route, per client address, per minute. Raise it if a
# shared network — a college, an office, one carrier's CGNAT — ever puts enough
# real learners behind one address to trip it. The limits that actually matter
# are counted per account and are unaffected by this.
# RATE_LIMIT_GLOBAL_PER_MINUTE=300
#
# The kill switch. Set to "true" only for a load test you are running against
# yourself on purpose; it turns off every limiter at once, including the one in
# front of the login form.
# RATE_LIMIT_DISABLED=false

# --- File uploads (Cloudinary) -------------------------------------------
# Optional. Without these the server still runs and everything except uploading
# a profile picture works; that one endpoint answers 503 UPLOADS_DISABLED.
#
# Copy the line straight off Cloudinary's API Keys screen — it is already in
# this shape:
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Or set the three parts separately, if a URL-shaped secret is awkward to store
# on your host. CLOUDINARY_URL wins when both are present.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
#
# Prefix every asset this app creates lives under, so a shared cloud stays tidy.
CLOUDINARY_FOLDER=maang-prep

# --- File storage (AWS S3) -----------------------------------------------
# Optional, like Cloudinary: without these the server still runs and everything
# except the S3-backed endpoints works; those answer 503 STORAGE_DISABLED.
#
# These two are the ONLY variables the S3 service needs.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=maang-prep-580912381247-ap-south-1-an
#
# There is deliberately no AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here, and
# adding them on the EC2 box would be a downgrade, not a convenience.
#
# The instance carries the IAM role MAANGPrepEC2S3Role (policy
# MAANGPrepNodeAppS3Access, scoped to the bucket above). The SDK's default
# credential provider chain reads short-lived credentials for that role from the
# instance metadata service and refreshes them before they expire — nothing is
# stored on disk, nothing needs rotating by hand, and there is no key to leak.
# Static IAM user keys would be the opposite on all three counts.
#
# Locally, the same chain checks env vars, then SSO, then ~/.aws/credentials —
# so `aws configure` or `AWS_PROFILE=...` is all a laptop needs, still with no
# secret in this file. Verify on the instance with:
#   aws sts get-caller-identity
#   aws s3 ls s3://maang-prep-580912381247-ap-south-1-an
#
# Everything the app writes lives under one key prefix, so a shared bucket stays
# sorted and a prefix delete can be scoped without guessing.
AWS_S3_PREFIX=maang-prep
#
# Set ONLY if the bucket is public or fronted by CloudFront — it is what makes
# publicUrl() return a permanent link. Leave it unset for a private bucket and
# reads go through short-lived signed URLs instead, which is the right default.
# AWS_S3_PUBLIC_URL=https://dxxxxxxxxxxxxx.cloudfront.net
#
# How long a signed URL stays valid, in seconds. Long enough to load a page and
# click through, short enough that a copied link goes stale. Default 900 (15m).
# AWS_S3_URL_TTL=900

# --- AI (Google Gemini) --------------------------------------------------
# Optional. Without this the server still runs and everything except the AI
# features works; those endpoints answer 503 AI_DISABLED, and the motivation
# lines fall back to the seeded ones, which is the normal path anyway.
#
# Get a key from https://aistudio.google.com/apikey. It is a Generative
# Language API key — a Google Cloud key restricted to other APIs will be
# accepted by this file and then rejected by Google as API_KEY_INVALID.
GEMINI_API_KEY=
#
# Google retires these on a published schedule, so they are variables rather
# than constants in the code. Two of them, because the two things this app asks
# a model for have opposite shapes.
#
# The quality tier. Admin drafting only — a handful of calls when someone clicks
# a button, every line read by a human before it ships. Free-tier quota on the
# newest Flash is 20 requests per day per model, which is plenty for that and
# nowhere near enough for anything per-learner.
GEMINI_MODEL=gemini-3.6-flash
#
# The cheap tier. This is what runs once per learner per day for the motivation
# line, so it scales with signups and needs quota headroom more than polish.
# Falls back to GEMINI_MODEL when unset.
#
# gemini-3.5-flash-lite is cheaper again, but it was measured against this app's
# own prompt and got the arithmetic wrong about one time in four, which no
# amount of output validation can catch. Set it only if you want that trade.
GEMINI_MODEL_FAST=gemini-3.5-flash

# --- AI (chat assistant providers) ---------------------------------------
# The chat assistant tries these in the order the admin panel lists them,
# falling through to the next one on failure. All optional: a key that is
# absent simply means that provider is never a candidate. With none of them
# set, chat runs on Gemini alone.
#
# Run `npm run ai:probe` after setting any of these. It streams one prompt
# through every configured provider and prints time-to-first-token, which is
# the only way to find out that a key authenticates but cannot bill — all
# three of these list their models happily on an account with no credit and
# then answer 402 the moment you ask for a token.
#
# Cerebras — https://cloud.cerebras.ai. Fastest to first token by a wide
# margin, which is the speed a reader actually perceives. Requires billing to
# be enabled; without it every model answers 402 "Payment required".
CEREBRAS_API_KEY=
#
# DeepSeek — https://platform.deepseek.com. Strong on code and the cheapest of
# the three to top up. Answers 402 "Insufficient Balance" at zero balance.
DEEPSEEK_API_KEY=
#
# xAI Grok — https://console.x.ai. Answers 403 "your team doesn't have any
# credits or licenses yet" until the team is funded.
GROK_API_KEY=
#
# Override a base URL only if a vendor moves one. Defaults are
# api.cerebras.ai/v1, api.deepseek.com/v1 and api.x.ai/v1.
# CEREBRAS_BASE_URL=
# DEEPSEEK_BASE_URL=
# GROK_BASE_URL=

# --- Admin panel ---------------------------------------------------------
# The one account that owns the site. Pinned here rather than stored as an
# editable row: no API path can grant or revoke super_admin, so the role cannot
# be handed out by a bug in the role endpoint or by a stolen admin session.
#
# The account is promoted on boot, on register and at every login, so it does
# not need to exist yet when you set this. Leave it unset and the app simply has
# no super admin — the panel still works for admin and dev_member, but nobody
# can edit problems or patterns, assign roles, or delete an account.
SUPER_ADMIN_EMAIL=you@example.com

# --- Outgoing mail (optional) ---------------------------------------------
# Signup approval sends four short messages: "we got your request" and
# "you're approved"/"not this time" to the applicant, and "somebody wants in"
# to you.
#
# Two backends, and the one that runs is decided by which credential is set —
# SendGrid first, then SMTP. Set neither and the flow still works end to end:
# requests queue, approvals create accounts, and the server logs each message
# it would have sent. The panel is how you find out either way.
#
# Whichever you use, MAIL_FROM has to be an address that sender is allowed to
# use. It is the one setting here that fails silently rather than loudly.

# SendGrid (recommended) — sendgrid.com, 100 messages a day on the free plan.
# Settings -> API Keys -> Create, with "Mail Send" permission and nothing else.
# Then Settings -> Sender Authentication -> Single Sender Verification, and
# verify the address you put in MAIL_FROM below. Without that every send is a
# 403 "does not match a verified Sender Identity".
#
# Sent over HTTPS rather than SendGrid's SMTP relay, so it also works on hosts
# that block outbound port 587.
SENDGRID_API_KEY=
MAIL_FROM=Ember <you@example.com>

# SMTP — any mailbox you already own, used only when SENDGRID_API_KEY is empty.
# A Gmail account needs an App Password: turn on 2-step verification, then
# myaccount.google.com/apppasswords for the 16 characters. Your normal Google
# password will not work. Limit is 500 messages a day.
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=you@gmail.com
# SMTP_PASS=
#
# 465 is TLS from the first byte; 587 starts plain and upgrades with STARTTLS.
# SMTP_SECURE follows the port unless you set it, which is the one mistake here
# that hangs rather than erroring.
# SMTP_PORT=465
# SMTP_SECURE=true

# Where "somebody wants in" goes. Defaults to SUPER_ADMIN_EMAIL; set this for a
# shared inbox instead.
# MAIL_ADMIN_TO=
