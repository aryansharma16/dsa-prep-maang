# Copy to .env and fill in. .env is gitignored; this file is not, so keep real
# secrets out of it.

NODE_ENV=development
PORT=4000

MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dsa-prep
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

LEETCODE_API=https://leetcode-api-pied.vercel.app

# --- File uploads (Cloudinary) -------------------------------------------
# Optional. Without these the server still runs and everything except uploading
# a profile picture works; that one endpoint answers 503 UPLOADS_DISABLED.
#
# Copy the line straight off Cloudinary's API Keys screen — it is already in
# this shape:
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Or set the three parts separately, if a URL-shaped secret is awkward to store
# on your host. CLOUDINARY_URL wins when both are present.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
#
# Prefix every asset this app creates lives under, so a shared cloud stays tidy.
CLOUDINARY_FOLDER=maang-prep
