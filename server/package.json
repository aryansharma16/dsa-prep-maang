{
  "name": "dsa-prep-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test \"src/**/__tests__/*.test.js\"",
    "design:purge-trash": "node scripts/design/purge-trash.js",
    "seed:fetch": "node scripts/seed/fetch-sources.js",
    "seed:curate": "node scripts/seed/curate.js",
    "seed:db": "node scripts/seed/seed.js",
    "seed:logos": "node scripts/seed/logos.js",
    "seed:guides": "node scripts/seed/guides.js",
    "seed:learn": "node scripts/seed/learn.js",
    "seed:learn:verify": "node scripts/seed/learn/verify.js",
    "seed:motivation": "node scripts/seed/motivations.js",
    "ai:draft": "node scripts/ai/draft-motivations.js",
    "seed": "npm run seed:fetch && npm run seed:curate && npm run seed:db",
    "seed:cp:fetch": "node scripts/seed/cp/fetch-cf.js",
    "seed:cp:sheets": "node scripts/seed/cp/fetch-sheets.js",
    "seed:cp:codechef": "node scripts/seed/cp/fetch-cc.js",
    "seed:cp:curate": "node scripts/seed/cp/curate.js",
    "seed:cp:solutions": "node scripts/seed/cp/fetch-solutions.js",
    "seed:cp:db": "node scripts/seed/cp/seed.js",
    "seed:cp:guides": "node scripts/seed/cp/guides.js",
    "seed:cp": "npm run seed:cp:fetch && npm run seed:cp:sheets && npm run seed:cp:codechef && npm run seed:cp:curate && npm run seed:cp:solutions && npm run seed:cp:db && npm run seed:cp:guides",
    "seed:sql:verify": "node scripts/seed/sql/verify.js",
    "seed:sql:db": "node scripts/seed/sql/seed.js",
    "seed:sql": "npm run seed:sql:verify && npm run seed:sql:db",
    "migrate:problem-slugs": "node scripts/migrate/problem-slug-owner.js",
    "migrate:attempt-ids": "node scripts/migrate/attempt-ids.js",
    "ai:probe": "node scripts/ai/probe-providers.js",
    "s3:probe": "node scripts/s3/probe-storage.js",
    "sql:probe": "node scripts/sql/probe-engine.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/lib-storage": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@google/genai": "^2.16.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "sql.js": "1.14.2"
  }
}
